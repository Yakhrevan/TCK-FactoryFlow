rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameOrg(orgId) {
      return signedIn() && request.auth.token.organisationId == orgId;
    }
    function roleIn(roles) {
      return signedIn() && request.auth.token.role in roles;
    }
    match /organisations/{orgId}/events/{eventId} {
      allow read: if sameOrg(orgId);
      allow create: if sameOrg(orgId)
        && roleIn(['owner', 'admin', 'manager', 'operator'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.organisationId == orgId
        && request.resource.data.keys().hasAll(['eventKey', 'eventType', 'payload', 'actorUid', 'organisationId', 'createdAt'])
        && request.resource.data.eventKey == eventId;
      allow update, delete: if false;
    }
    // Master stock, roles, product configuration and posted transactions are not
    // client-writable documents. Use a trusted backend/Cloud Function with
    // transaction validation and App Check before enabling shared live inventory.
    match /organisations/{orgId}/{document=**} {
      allow read: if sameOrg(orgId);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
